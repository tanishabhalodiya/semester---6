@model System.Data.DataTable
@using System.Data

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark mb-0">Doctor List</h2>
        <a asp-controller="Doctor" asp-action="DoctorFillData" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add
        </a>
    </div>
    <div class="table-responsive shadow rounded-3 border border-primary">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="table-primary text-dark">
                <tr>
                    <th>ID</th>
                    @* <th>Photo</th> *@
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Qualification</th>
                    <th>Specialization</th>
                    <th>IsActive</th>
                    <th>Created</th>
                    <th>Modified</th>
                    <th>UserID</th>
                    <th colspan="2">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow dr in Model.Rows)
                {
                    <tr>

                        <td>@dr["DoctorID"]</td>
                        @* <td>
                            <img width="100" src="@Url.Content("/" + dr["ProfileImgSrc"])" alt="Profile image">
                        </td> *@

                        <td>@dr["Name"]</td>
                        <td>@dr["Phone"]</td>
                        <td>@dr["Email"]</td>
                        <td>@dr["Qualification"]</td>
                        <td>@dr["Specialization"]</td>

                        <td>
                            @if ((bool)dr["IsActive"])
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>@Convert.ToDateTime(dr["Created"]).ToString("dd-MM-yyyy")</td>
                        <td>@Convert.ToDateTime(dr["Modified"]).ToString("dd-MM-yyyy")</td>
                        <td>@dr["UserName"]</td>
                        <td>
                            <form asp-controller="Doctor" asp-action="DoctorFillData" asp-route-DoctorID="@dr["DoctorID"]">
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                            </form>
                        </td>
                        <td>
                            <form asp-controller="Doctor" asp-action="DoctorDelete" asp-route-DoctorID="@dr["DoctorID"]" onsubmit="return confirm('Are you sure you want to delete this doctor?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
