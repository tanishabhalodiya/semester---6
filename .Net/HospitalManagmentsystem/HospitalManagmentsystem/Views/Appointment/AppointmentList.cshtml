@model System.Data.DataTable
@using System.Data

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark mb-0">Appointment List</h2>
        <div class="d-flex gap-2">
            <a asp-controller="Appointment" asp-action="AppointmentAddEdit"
               class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
                <i class="bi bi-plus-circle me-1"></i> Add
            </a>

            <a asp-controller="Appointment" asp-action="ExportToExcel"
               class="btn btn-success px-4 py-2 shadow-sm rounded-pill">
                <i class="bi bi-download me-1"></i> Export
            </a>

            <button type="submit" form="bulkDeleteForm"
                    class="btn btn-danger px-4 py-2 shadow-sm rounded-pill"
                    onclick="return confirm('Are you sure you want to delete selected appointments?');">
                <i class="bi bi-trash me-1"></i> Delete All
            </button>
        </div>
    </div>

    <form method="post" asp-controller="Appointment" asp-action="Search" class="mb-3 d-flex gap-2">
        <input type="text" name="searchData" class="form-control w-25" placeholder="Search by Doctor, Patient, Status"
               value="@ViewBag.SearchData" />
        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-search"></i> Search
        </button>
        <a href="@Url.Action("Search")" class="btn btn-secondary">Clear</a>
    </form>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success text-center fw-semibold">@TempData["Message"]</div>
    }

    <!-- Bulk Delete Form -->
    <form id="bulkDeleteForm" asp-controller="Appointment" asp-action="AppointmentDeleteAll" method="post">
        <div class="table-responsive shadow rounded-3 border border-primary">
            <table class="table table-hover table-bordered text-center align-middle mb-0">
                <thead class="table-primary text-dark">
                    <tr>
                        <th><input type="checkbox" id="selectAll" /></th>
                        <th>Appointment ID</th>
                        <th>Doctor Name</th>
                        <th>Patient Name</th>
                        <th>Appointment Date</th>
                        <th>Status</th>
                        <th>Description</th>
                        <th>Remarks</th>
                        <th>Created</th>
                        <th>Modified</th>
                        <th>User Name</th>
                        <th>Consulted Amount</th>
                        <th colspan="2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow dr in Model.Rows)
                    {
                        <tr>
                            <td><input type="checkbox" name="selectedIds" value="@dr["AppointmentID"]" class="selectItem" /></td>
                            <td>@dr["AppointmentID"]</td>
                            <td>@dr["DoctorName"]</td>
                            <td>@dr["PatientName"]</td>
                            <td>@Convert.ToDateTime(dr["AppointmentDate"]).ToString("dd-MM-yyyy")</td>
                            <td><span class="badge bg-info text-dark">@dr["AppointmentStatus"]</span></td>
                            <td>@dr["Description"]</td>
                            <td>@dr["SpecialRemarks"]</td>
                            <td>@Convert.ToDateTime(dr["Created"]).ToString("dd-MM-yyyy")</td>
                            <td>@Convert.ToDateTime(dr["Modified"]).ToString("dd-MM-yyyy")</td>
                            <td>@dr["UserName"]</td>
                            <td><strong>₹@dr["TotalConsultedAmount"]</strong></td>
                            <td class="d-flex justify-content-center gap-2">
                                <form asp-controller="Appointment" asp-action="AppointmentFillData"
                                      asp-route-AppointmentID="@dr["AppointmentID"]">
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </form>
                                <form asp-controller="Appointment" asp-action="AppointmentDelete"
                                      asp-route-AppointmentID="@dr["AppointmentID"]"
                                      onsubmit="return confirm('Are you sure you want to delete this appointment?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<script>
    document.getElementById("selectAll").onclick = function () {
        document.querySelectorAll(".selectItem").forEach(cb => cb.checked = this.checked);
    };
</script>


