@model HospitalManagmentsystem.Models.PatientModel

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient bg-primary text-white text-center py-4 rounded-top">
            <h4 class="fw-bold mb-0">
                <i class="bi bi-hospital-fill"></i> Patient Add/Edit
            </h4>
        </div>
        <div class="card-body bg-light p-4">
            <form class="row g-4" method="post" asp-controller="Patient" asp-action="PatientAddEdit">
                <input type="hidden" asp-for="PatientID" />

                <div class="col-md-6">
                    <label for="name" class="form-label fw-semibold text-dark">
                        <i class="bi bi-person"></i> Patient Name
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="name" asp-for="Name" placeholder="Enter patient name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label for="dob" class="form-label fw-semibold text-dark">
                        <i class="bi bi-calendar-event"></i> Date of Birth
                    </label>

                    <input type="date" class="form-control rounded-3 shadow-sm border-primary" id="dob" asp-for="DateOfBirth" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label for="gender" class="form-label fw-semibold text-dark">
                        <i class="bi bi-gender-ambiguous"></i> Gender
                    </label>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                    <select class="form-select rounded-3 shadow-sm border-primary" id="gender" asp-for="Gender">
                        <option value="">Select Gender</option>
                        <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                        <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                        <option value="Other" selected="@(Model.Gender == "Other")">Other</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="email" class="form-label fw-semibold text-dark">
                        <i class="bi bi-envelope-fill"></i> Email
                    </label>
                    <input type="email" class="form-control rounded-3 shadow-sm border-primary" id="email" asp-for="Email" placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label for="phone" class="form-label fw-semibold text-dark">
                        <i class="bi bi-telephone-fill"></i> Phone
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="phone" asp-for="Phone" placeholder="Enter phone number" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label for="address" class="form-label fw-semibold text-dark">
                        <i class="bi bi-geo-alt-fill"></i> Address
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="address" asp-for="Address" placeholder="Enter address" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label for="city" class="form-label fw-semibold text-dark">
                        <i class="bi bi-building"></i> City
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="city" asp-for="City" placeholder="Enter city" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label for="state" class="form-label fw-semibold text-dark">
                        <i class="bi bi-flag-fill"></i> State
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="state" asp-for="State" placeholder="Enter state" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold text-dark d-block">
                        <i class="bi bi-toggle-on"></i> Is Active
                    </label>
                    <div class="form-check form-switch ms-2">
                        <input type="checkbox" class="form-check-input shadow-sm" asp-for="IsActive" id="isActive" />
                        <label for="isActive" class="form-check-label">Active</label>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                </div>

                <!-- User ID -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark">
                        <i class="bi bi-person-circle"></i> User
                    </label>
                    <select asp-for="UserID" asp-items="@(new SelectList(ViewBag.UserList, "UserID", "UserName"))" class="form-control">
                        <option value="">--Select User--</option>
                    </select>
                    <span asp-validation-for="UserID" class="text-danger"></span>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success btn-lg px-5 rounded-3 shadow-sm me-2">
                        <i class="bi bi-check-circle"></i> Submit
                    </button>
                    <button type="reset" class="btn btn-outline-secondary btn-lg px-5 rounded-3 shadow-sm">
                        <i class="bi bi-x-circle"></i> Reset
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

