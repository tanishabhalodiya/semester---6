@model System.Data.DataTable
@using System.Data

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark mb-0">Patient List</h2>
        <a asp-controller="Patient" asp-action="PatientFillData" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add
        </a>
    </div>

    <div class="table-responsive shadow rounded-3 border border-primary">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="table-primary text-dark">
                <tr>
                    <th>Patient ID</th>
                    <th>Name</th>
                    <th>Date of Birth</th>
                    <th>Gender</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>State</th>
                    <th>IsActive</th>
                    <th>Created</th>
                    <th>Modified</th>
                    <th>User Name</th>
                    <th colspan="2">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (DataRow dr in Model.Rows)
                {
                    <tr>
                        <td>@dr["PatientID"]</td>
                        <td>@dr["Name"]</td>
                        <td>@Convert.ToDateTime(dr["DateOfBirth"]).ToString("dd-MM-yyyy")</td>
                        <td>@dr["Gender"]</td>
                        <td>@dr["Email"]</td>
                        <td>@dr["Phone"]</td>
                        <td>@dr["Address"]</td>
                        <td>@dr["City"]</td>
                        <td>@dr["State"]</td>

                        <td>
                            @if ((bool)dr["IsActive"])
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>

                        <td>@Convert.ToDateTime(dr["Created"]).ToString("dd-MM-yyyy")</td>
                        <td>@Convert.ToDateTime(dr["Modified"]).ToString("dd-MM-yyyy")</td>
                        <td>@dr["UserName"]</td>

                        <td>
                            <form asp-controller="Patient" asp-action="PatientFillData" asp-route-PatientID="@dr["PatientID"]">
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                            </form>
                        </td>

                        <td>
                            <form asp-controller="Patient" asp-action="PatientDelete" asp-route-PatientID="@dr["PatientID"]"
                                  onsubmit="return confirm('Are you sure you want to delete this patient?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

