@model System.Data.DataTable
@using System.Data

<h1>Employee List</h1>

<table class="table datatable overflow-y-auto">
    <thead>
        <tr>
            <th>Employee ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Date of Birth</th>
            <th>Gender</th>
            <th>Hire Date</th>
            <th>Job Title</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Is Active</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th colspan="2">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataRow dr in Model.Rows)
        {
            <tr>
                <td>@dr["EmployeeId"]</td>
                <td>@dr["FirstName"]</td>
                <td>@dr["LastName"]</td>
                <td>@dr["Email"]</td>
                <td>@dr["PhoneNumber"]</td>
                <td>@Convert.ToDateTime(dr["DateOfBirth"]).ToString("dd-MM-yyyy")</td>
                <td>@dr["Gender"]</td>
                <td>@Convert.ToDateTime(dr["HireDate"]).ToString("dd-MM-yyyy")</td>
                <td>@dr["JobTitle"]</td>
                <td>@dr["Department"]</td>
                <td>@dr["Salary"]</td>
                <td>@(Convert.ToBoolean(dr["IsActive"]) ? "Yes" : "No")</td>
                <td>@Convert.ToDateTime(dr["CreatedAt"]).ToString("dd-MM-yyyy")</td>
                <td>@(dr["UpdateAt"] == DBNull.Value ? "" : Convert.ToDateTime(dr["UpdateAt"]).ToString("dd-MM-yyyy"))</td>
                <td class="d-flex gap-2">
                    <!-- Edit -->
                    <form asp-controller="Employee" asp-action="EmployeeFillData" asp-route-EmployeeId="@dr["EmployeeId"]">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </form>

                    <!-- Delete -->
                    <form asp-controller="Employee" asp-action="EmployeeDelete" asp-route-EmployeeId="@dr["EmployeeId"]" onsubmit="return confirm('Are you sure you want to delete this employee?');">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
