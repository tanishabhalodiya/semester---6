@model HospitalManagmentsystem.Models.EmployeeModel

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Employee Add/Edit Form</h5>

        <form class="row g-3" method="post" asp-controller="Employee" asp-action="EmployeeAddEdit">
            <input type="hidden" asp-for="EmployeeID" />

            <div class="col-6">
                <label class="form-label">First Name</label>
                <input type="text" class="form-control" asp-for="FirstName" />
            </div>

            <div class="col-6">
                <label class="form-label">Last Name</label>
                <input type="text" class="form-control" asp-for="LastName" />
            </div>

            <div class="col-6">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" asp-for="Email" />
            </div>

            <div class="col-6">
                <label class="form-label">Phone Number</label>
                <input type="text" class="form-control" asp-for="PhoneNumber" />
            </div>

            <div class="col-4">
                <label class="form-label">Date of Birth</label>
                <input type="date" class="form-control" asp-for="DateOfBirth" />
            </div>

            <div class="col-4">
                <label class="form-label">Gender</label>
                <select class="form-control" asp-for="Gender">
                    <option value="">-- Select --</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Other</option>
                </select>
            </div>

            <div class="col-4">
                <label class="form-label">Hire Date</label>
                <input type="date" class="form-control" asp-for="HireDate" />
            </div>

            <div class="col-6">
                <label class="form-label">Job Title</label>
                <input type="text" class="form-control" asp-for="JobTitle" />
            </div>

            <div class="col-6">
                <label class="form-label">Department</label>
                <input type="text" class="form-control" asp-for="Department" />
            </div>

            <div class="col-6">
                <label class="form-label">Salary</label>
                <input type="number" step="0.01" class="form-control" asp-for="Salary" />
            </div>

            <div class="col-6">
                <label class="form-label">Is Active</label>
                <select class="form-control" asp-for="IsActive">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </div>

            @* Optional if needed for editing existing data *@
            @*<div class="col-6">
                <label class="form-label">Created At</label>
                <input type="date" class="form-control" asp-for="CreatedAt" readonly />
            </div>

            <div class="col-6">
                <label class="form-label">Updated At</label>
                <input type="date" class="form-control" asp-for="UpdatedAt" />
            </div>*@

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
            </div>
        </form>
    </div>
</div>
