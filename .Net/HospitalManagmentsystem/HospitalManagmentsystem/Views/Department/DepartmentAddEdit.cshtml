@model HospitalManagmentsystem.Models.DepartmentModel

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient bg-primary text-white text-center py-4 rounded-top">
            <h4 class="fw-bold mb-0">
                <i class="bi bi-building"></i> Department Add/Edit
            </h4>
        </div>
        <div class="card-body bg-light p-4">
            <form class="row g-4" method="post" asp-controller="Department" asp-action="DepartmentAddEdit">
                <input type="hidden" value="@Model.DepartmentID" asp-for="DepartmentID" />

                <div class="col-md-6">
                    <label for="deptName" class="form-label fw-semibold text-dark">
                        <i class="bi bi-card-text"></i> Department Name
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="deptName" asp-for="DepartmentName" placeholder="Enter department name" />
                </div>

                <div class="col-md-6">
                    <label for="description" class="form-label fw-semibold text-dark">
                        <i class="bi bi-chat-left-dots"></i> Description
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="description" asp-for="Description" placeholder="Enter description" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark d-block">
                        <i class="bi bi-toggle-on"></i> Is Active
                    </label>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="IsActive" />
                        <label class="form-check-label" for="IsActive">Active</label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark">
                        <i class="bi bi-person-circle"></i> User
                    </label>
                    <select asp-for="UserID" asp-items="@(new SelectList(ViewBag.UserList, "UserID", "UserName"))" class="form-control">
                        <option value="">--Select User--</option>
                    </select>
                    <span asp-validation-for="UserID" class="text-danger"></span>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success btn-lg px-5 rounded-3 shadow-sm me-2">
                        <i class="bi bi-check-circle"></i> Submit
                    </button>
                    <button type="reset" class="btn btn-outline-secondary btn-lg px-5 rounded-3 shadow-sm">
                        <i class="bi bi-x-circle"></i> Reset
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
