@model System.Data.DataTable;
@using System.Data;

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark mb-0">Department List</h2>
        <a asp-controller="Department" asp-action="DepartmentAddEdit" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add
        </a>
        
    </div>
    <div class="table-responsive shadow rounded-3 border border-primary">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="table-primary text-dark">
                <tr>
                    
                    <th>Department ID</th>
                    <th>Department Name</th>
                    <th>Description</th>
                    <th>Is Active</th>
                    <th>Created</th>
                    <th>Modified</th>
                    <th>User Name</th>
                    <th colspan="2">Actions</th>
                </tr>
            </thead>
            <tbody>
                <script>
                    document.getElementById("selectAll").onclick = function () {
                        let checkboxes = document.getElementsByClassName("selectItem");
                        for (let box of checkboxes) {
                            box.checked = this.checked;
                        }
                    };
                </script>
                @foreach (DataRow dr in Model.Rows)
                {
                    <tr>
                        
                        <td>@dr["DepartmentID"]</td>
                        <td>@dr["DepartmentName"]</td>
                        <td>@dr["Description"]</td>
                        <td>
                            @if ((bool) dr["IsActive"])
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>@Convert.ToDateTime(dr["Created"]).ToString("dd-MM-yyyy")</td>
                        <td>@Convert.ToDateTime(dr["Modified"]).ToString("dd-MM-yyyy")</td>
                        <td>@dr["UserName"]</td>

                        <td class="text-center">
                            <form asp-controller="Department" asp-action="DepartmentFillData" asp-route-DepartmentID="@dr["DepartmentID"]">
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                            </form>
                        </td>
                        <td class="text-center">
                            <form asp-controller="Department" asp-action="DepartmentDelete" asp-route-DepartmentID="@dr["DepartmentID"]"
                                  onsubmit="return confirm('Are you sure you want to delete this department?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
    