@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
}

@model HospitalManagmentsystem.Models.UserLoginModel

<main>
    <div class="container d-flex justify-content-center align-items-center min-vh-100" style="background: linear-gradient(135deg, #f0f8ff, #d6eaff);">
        <div class="card shadow-lg border-0 rounded-5" style="max-width: 420px; width: 100%;">
            <div class="card-header text-center bg-primary text-white rounded-top" style="padding: 1.5rem;">
                <h3 class="mb-0 fw-bold">HMS Login</h3>
                <p class="small mb-0">Sign in to continue</p>
            </div>
            <div class="card-body p-4">

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger text-center mb-3">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form class="row g-3 needs-validation" asp-action="UserLogin" asp-controller="User">
                    <div class="col-12">
                        <label for="yourUsername" class="form-label fw-semibold text-primary">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-primary text-white"><i class="bi bi-person-fill"></i></span>
                            <input type="text" asp-for="UserName" class="form-control rounded-end" id="yourUsername" placeholder="Enter your username">
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label for="yourPassword" class="form-label fw-semibold text-primary">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-primary text-white"><i class="bi bi-lock-fill"></i></span>
                            <input type="password" asp-for="Password" class="form-control rounded-end" id="yourPassword" placeholder="Enter your password">
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-12 d-flex justify-content-between align-items-center mt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="remember" value="true" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">Remember me</label>
                        </div>
                        <a href="#" class="text-decoration-none text-primary small">Forgot Password?</a>
                    </div>

                    <div class="col-12 mt-3">
                        <button class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm" type="submit">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </button>
                    </div>
                    <div class="col-12 text-center mt-2">
                        <p class="small mb-0">Don't have an account? <a href="/User/UserFillData" class="text-primary fw-semibold">Create one</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}


