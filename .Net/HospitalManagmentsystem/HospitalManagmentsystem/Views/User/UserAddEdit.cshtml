@model HospitalManagmentsystem.Models.UserModel

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient bg-primary text-white text-center py-4 rounded-top">
            <h4 class="fw-bold mb-0">
                <i class="bi bi-person-fill"></i> User Add/Edit
            </h4>
        </div>
        <div class="card-body bg-light p-4">
            <form class="row g-4" method="post" asp-controller="User" asp-action="UserAddEdit">
                <input type="hidden" asp-for="UserID" />

                <div class="col-md-6">
                    <label for="userName" class="form-label fw-semibold text-dark">
                        <i class="bi bi-person-badge"></i> User Name
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="userName" asp-for="UserName" placeholder="Enter user name" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label for="password" class="form-label fw-semibold text-dark">
                        <i class="bi bi-lock-fill"></i> Password
                    </label>
                    <input type="password" class="form-control rounded-3 shadow-sm border-primary" id="password" asp-for="Password" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label for="email" class="form-label fw-semibold text-dark">
                        <i class="bi bi-envelope-fill"></i> Email
                    </label>
                    <input type="email" class="form-control rounded-3 shadow-sm border-primary" id="email" asp-for="Email" placeholder="Enter email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label for="mobile" class="form-label fw-semibold text-dark">
                        <i class="bi bi-telephone-fill"></i> Mobile No
                    </label>
                    <input type="text" class="form-control rounded-3 shadow-sm border-primary" id="mobile" asp-for="MobileNo" placeholder="Enter mobile number" />
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark d-block">
                        <i class="bi bi-toggle-on"></i> Is Active
                    </label>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="IsActive"/>
                        <label class="form-check-label" for="IsActive">Active</label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success btn-lg px-5 rounded-3 shadow-sm me-2">
                        <i class="bi bi-check-circle"></i> Submit
                    </button>
                    <button type="reset" class="btn btn-outline-secondary btn-lg px-5 rounded-3 shadow-sm">
                        <i class="bi bi-x-circle"></i> Reset
                    </button>
                </div>
                <div class="text-center mt-3">
                    <p class="small">Already have an account? <a href="/User/UserLogin" class="text-primary">Login here</a></p>
                </div>

            </form>
        </div>
    </div>
</div>




