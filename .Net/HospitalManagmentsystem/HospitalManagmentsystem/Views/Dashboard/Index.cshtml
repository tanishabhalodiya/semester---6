<!-- After Quick Actions -->
<div class="card mt-3">
    <div class="card-header"><h5 class="mb-0">System Overview</h5></div>
    <div class="card-body d-flex flex-wrap gap-3">
        <div class="p-3 text-center" style="flex:1; background:#f8f9fa; border-radius:12px;">
            <i class="bi bi-activity" style="font-size:30px; color:#4154f1;"></i>
            <p class="mt-2 mb-0 fw-bold">Active Sessions</p>
            <p class="mb-0 text-muted">12 Users</p>
        </div>
        <div class="p-3 text-center" style="flex:1; background:#f8f9fa; border-radius:12px;">
            <i class="bi bi-clock-history" style="font-size:30px; color:#ff771d;"></i>
            <p class="mt-2 mb-0 fw-bold">Avg. Response Time</p>
            <p class="mb-0 text-muted">1.2 sec</p>
        </div>
        <div class="p-3 text-center" style="flex:1; background:#f8f9fa; border-radius:12px;">
            <i class="bi bi-shield-lock" style="font-size:30px; color:#2eca6a;"></i>
            <p class="mt-2 mb-0 fw-bold">Security Status</p>
            <p class="mb-0 text-muted">Good</p>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const counters = document.querySelectorAll('.counter');
            counters.forEach(counter => {
                let target = +counter.getAttribute('data-target');
                let count = 0;
                let speed = 20;
                let updateCount = () => {
                    if (count < target) {
                        count += Math.ceil(target / 100);
                        counter.textContent = count;
                        setTimeout(updateCount, speed);
                    } else {
                        counter.textContent = target;
                    }
                };
                updateCount();
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('specializationChart').getContext('2d');
        var specializationChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: [@string.Join(",", Model.TopSpecializations.Select(s => $"'{s.Specialization}'"))],
                datasets: [{
                    data: [@string.Join(",", Model.TopSpecializations.Select(s => s.Count))],
                    backgroundColor: ['#4154f1', '#2eca6a', '#ff771d', '#ff4081', '#673ab7']
                }]
            }
        });
    </script>
}


